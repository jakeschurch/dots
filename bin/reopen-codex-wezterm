#!/usr/bin/env python3
"""Reopen running Linux Codex CLI conversations in fresh WezTerm processes."""

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path


def sessions():
    found = {}
    for proc in sorted(Path('/proc').glob('[0-9]*'), key=lambda p: int(p.name)):
        try:
            if proc.stat().st_uid != os.getuid():
                continue
            if (proc / 'comm').read_text().strip() not in ('codex', '.codex-wrapped'):
                continue
            if not os.readlink(proc / 'fd/0').startswith('/dev/pts/'):
                continue
            for fd in (proc / 'fd').iterdir():
                try:
                    target = os.readlink(fd)
                    if '/sessions/' not in target or not target.endswith('.jsonl'):
                        continue
                    with open(target, encoding='utf-8') as f:
                        meta = json.loads(f.readline()).get('payload', {})
                    if meta.get('source') != 'cli':
                        continue
                    session_id, cwd = meta.get('id'), meta.get('cwd')
                    if session_id and cwd and os.path.isdir(cwd):
                        found.setdefault(session_id, cwd)
                except (OSError, ValueError):
                    continue
        except (OSError, ValueError, json.JSONDecodeError):
            continue
    return list(found.items())


def cli(sock, *args):
    env = os.environ.copy()
    env['WEZTERM_UNIX_SOCKET'] = str(sock)
    return subprocess.run(
        ['wezterm', 'cli', '--no-auto-start', *args], env=env,
        check=True, capture_output=True, text=True, timeout=10,
    ).stdout.strip()


def start_window(group):
    session_id, cwd = group[0]
    env = os.environ.copy()
    env.pop('WEZTERM_UNIX_SOCKET', None)
    env.pop('WEZTERM_PANE', None)
    process = subprocess.Popen(
        ['wezterm', 'start', '--always-new-process', '--cwd', cwd, '--',
         'codex', 'resume', '--no-daemon', '-C', cwd, session_id],
        env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True,
    )
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    sock = runtime / 'wezterm' / f'gui-sock-{process.pid}'
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise RuntimeError(f'WezTerm exited while starting session {session_id}')
        if sock.exists():
            try:
                panes = json.loads(cli(sock, 'list', '--format', 'json'))
                if panes:
                    break
            except (subprocess.SubprocessError, json.JSONDecodeError):
                pass
        time.sleep(0.2)
    else:
        raise RuntimeError(f'WezTerm control socket not ready: {sock}')

    first = str(panes[0]['pane_id'])
    for session_id, cwd in group[1:]:
        cli(sock, 'spawn', '--pane-id', first, '--cwd', cwd, '--',
            'codex', 'resume', '--no-daemon', '-C', cwd, session_id)
    print(f'Opened {len(group)} session(s) in WezTerm PID {process.pid}', flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--dry-run', action='store_true', help='list sessions without opening windows')
    args = parser.parse_args()
    found = sessions()
    if not found:
        print('No running interactive Codex sessions found.', file=sys.stderr)
        return 1
    for session_id, cwd in found:
        print(f'{session_id}  {cwd}', flush=True)
    if not args.dry_run:
        for i in range(0, len(found), 3):
            start_window(found[i:i + 3])
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError, subprocess.SubprocessError) as e:
        print(f'Error: {e}', file=sys.stderr)
        sys.exit(1)
